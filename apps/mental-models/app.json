{
  "expo": {
    "name": "Senik",
    "slug": "mental-models",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "senik",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0E1014"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.qaizo.senik",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1014"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.qaizo.senik",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app-check",
      "expo-apple-authentication",
      "./plugins/with-adi-registration.js"
    ],
    "extra": {
      "appSlug": "mental-models",
      "eas": {
        "projectId": "fef49184-7cf2-45f8-a6d1-5ff878c08d3d"
      }
    },
    "owner": "qaizo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fef49184-7cf2-45f8-a6d1-5ff878c08d3d"
    }
  }
}
